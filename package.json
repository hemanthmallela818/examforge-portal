{
  "name": "examforge-portal",
  "private": true,
  "version": "1.0.0",
  "description": "Security-hardened computer-based examination portal built with React and Supabase.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=scripts/connected-staging.mjs --test-coverage-exclude=scripts/rehearse-connected-staging.mjs --test-coverage-exclude=e2e/support/fixtures.mjs --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=90 --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "test:e2e:critical": "playwright test e2e/auth.spec.mjs e2e/admin-critical.spec.mjs e2e/student-exam.spec.mjs e2e/takeover.spec.mjs",
    "test:rehearsal": "node scripts/rehearse-staging.mjs",
    "test:rehearsal:staging": "node scripts/rehearse-connected-staging.mjs",
    "test:rehearsal:local": "node scripts/rehearse-local.mjs",
    "root:bootstrap": "node scripts/bootstrap-admin.mjs",
    "root:bootstrap:staging": "node scripts/bootstrap-connected-staging-root.mjs",
    "root:bootstrap:main": "node scripts/bootstrap-connected-main-root.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "ops:check": "node scripts/operational-health-check.mjs",
    "ops:check:local": "node scripts/operational-health-check.mjs --local --json",
    "ops:check:main": "node scripts/operational-health-main.mjs",
    "ops:verify-root:local": "node scripts/verify-root-hierarchy.mjs",
    "ops:verify-root:staging": "node scripts/verify-connected-staging-root.mjs",
    "ops:verify-reset-preview:staging": "node scripts/verify-connected-staging-reset-preview.mjs",
    "ops:verify-reset-preview:main": "node scripts/verify-connected-main-reset-preview.mjs",
    "ops:verify-reset:staging": "node scripts/verify-connected-staging-reset.mjs",
    "ops:verify-stage27:staging": "node scripts/verify-stage27-staging.mjs",
    "ops:verify-stage27:main": "node scripts/verify-stage27-staging.mjs --main",
    "ops:verify-root:main": "node scripts/verify-connected-main-root.mjs",
    "ops:verify-hierarchy:main": "node scripts/verify-connected-main-hierarchy.mjs",
    "ops:drill:staging": "node scripts/operator-drill-staging.mjs",
    "ops:prove-restore:local": "node scripts/prove-local-backup-restore.mjs",
    "ops:prove-restore:staging": "node scripts/prove-staging-backup-restore.mjs",
    "ops:prove-storage-restore:local": "node scripts/prove-local-storage-restore.mjs",
    "ops:prove-storage-restore:staging": "node scripts/prove-local-storage-restore.mjs --staging",
    "supabase:local": "node scripts/run-supabase.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:syntax": "node --check src/runtimeConfig.js src/runtimeDiagnostics.js src/browserStorage.js src/adminDataReliability.js src/numericalAnswerPolicy.js src/resultExportLogic.js src/accessibilityLogic.js src/imageValidation.js src/importLogic.js src/examLogic.js src/examPreflightLogic.js src/paginatedQuery.js src/questionBankPaging.js src/examListPaging.js src/resultPaging.js scripts/bootstrap-admin.mjs scripts/operational-health-check.mjs scripts/prove-local-backup-restore.mjs scripts/prove-local-storage-restore.mjs scripts/rehearse-staging.mjs scripts/rehearse-local.mjs scripts/run-supabase.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:components": "vitest run --config vitest.config.mjs",
    "test:db": "node --test --test-concurrency=1 tests/db/*.test.mjs",
    "schema:reference": "node scripts/generate-schema-reference.mjs",
    "schema:reference:check": "node scripts/generate-schema-reference.mjs --check",
    "schema:snapshot": "node node_modules/supabase/dist/supabase.js db dump --local --schema public -f supabase/schema/public.sql"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "katex": "0.18.7",
    "lucide-react": "1.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.0",
    "tailwind-merge": "3.7.0"
  }
}
